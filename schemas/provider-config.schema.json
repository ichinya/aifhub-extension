{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ichinya/aifhub-extension/main/schemas/provider-config.schema.json",
  "title": "AIFHub aifhub.providers configuration v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hlv": { "allOf": [{ "$ref": "#/$defs/provider" }, { "properties": {
      "phases": { "items": { "enum": ["verify", "done"] } }
    } }] },
    "lekalo": { "$ref": "#/$defs/provider" }
  },
  "$defs": {
    "provider": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["optional", "required"], "default": "required" },
        "phases": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["implement", "verify", "done"] } },
        "executable": { "type": "string", "minLength": 1,
          "description": "Absolute path to a user-installed native executable; script and shell wrappers are rejected at runtime." },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000, "default": 30000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 4194304, "default": 1048576 }
      }
    }
  }
}
