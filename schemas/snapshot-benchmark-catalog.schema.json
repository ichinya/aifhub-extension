{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "generator_revision",
    "seed",
    "order_seed",
    "profiles",
    "repeats",
    "warmups",
    "os_cache",
    "limits",
    "privacy_canaries",
    "no_promote",
    "scenarios",
    "arms",
    "generator_digest",
    "catalog_digest"
  ],
  "properties": {
    "schema": {
      "const": "aifhub.snapshot.ab_scenario_catalog.v1"
    },
    "revision": {
      "const": 1
    },
    "generator_revision": {
      "const": "snapshot-fixture-1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "order_seed": {
      "type": "integer",
      "minimum": 0
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "process-cold",
          "process-warm",
          "diagnostic"
        ]
      },
      "minItems": 1
    },
    "repeats": {
      "const": 10
    },
    "warmups": {
      "const": 2
    },
    "os_cache": {
      "const": "uncontrolled"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "file_bytes",
        "scoped_leaves",
        "total_names"
      ],
      "properties": {
        "concurrency": {
          "const": 1
        },
        "file_bytes": {
          "const": 16777216
        },
        "scoped_leaves": {
          "const": 10000
        },
        "total_names": {
          "const": 20000
        }
      }
    },
    "privacy_canaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "no_promote": {
      "const": true
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "modules",
          "leaves",
          "scope",
          "content",
          "operation",
          "variant",
          "expected_codes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "family": {
            "enum": [
              "W",
              "S",
              "B",
              "I",
              "H",
              "F",
              "N"
            ]
          },
          "modules": {
            "enum": [
              0,
              2,
              4,
              8,
              16
            ]
          },
          "leaves": {
            "type": "integer",
            "minimum": 32,
            "maximum": 10000
          },
          "scope": {
            "enum": [
              "exact",
              "directory"
            ]
          },
          "content": {
            "enum": [
              "small",
              "io-heavy"
            ]
          },
          "operation": {
            "enum": [
              "snapshot",
              "lifecycle",
              "result-replay",
              "accept-replay",
              "replay",
              "preflight",
              "start",
              "negative"
            ]
          },
          "variant": {
            "type": "string"
          },
          "expected_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z-]+$"
            }
          },
          "order": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true
          },
          "changes": {
            "enum": [
              1,
              20
            ]
          },
          "history": {
            "enum": [
              "small",
              "large"
            ]
          },
          "baseline_gap": {
            "type": "boolean"
          },
          "active_runs": {
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 200
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "identity"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commit",
              "source",
              "modules"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "source": {
                "enum": [
                  "committed",
                  "working-tree"
                ]
              },
              "modules": {
                "type": "object",
                "minProperties": 3,
                "propertyNames": {
                  "pattern": "^scripts/[a-zA-Z0-9_./-]+\\.mjs$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      },
      "minItems": 0,
      "maxItems": 2
    },
    "generator_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aifhub.snapshot.ab_scenario_catalog.v1"
}
