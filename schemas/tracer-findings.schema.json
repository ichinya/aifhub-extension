{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracer findings v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aifhub.tracer_findings.v1"
    },
    "change_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "assumption",
              "result",
              "evidence",
              "risk",
              "question"
            ]
          },
          "summary": {
            "type": "string"
          },
          "invalidated_assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "category",
          "summary"
        ]
      }
    },
    "result_summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "description"
        ]
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "change_id",
    "findings",
    "result_summary",
    "evidence",
    "created_at",
    "updated_at"
  ]
}
