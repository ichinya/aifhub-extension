{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context selection overlay observation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aifhub.context_selection_overlay_observation.v1"
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "diagnostic_only": {
      "const": true
    },
    "authorizes": {
      "type": "array",
      "maxItems": 0
    },
    "language": {
      "enum": [
        "ru",
        "en",
        "unknown"
      ]
    },
    "language_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "override": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      },
      "required": [
        "override"
      ]
    },
    "run_status": {
      "enum": [
        "complete",
        "failed",
        "not_run"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "freshness": {
      "enum": [
        "current",
        "stale"
      ]
    },
    "abstained": {
      "type": "boolean"
    },
    "needs_review": {
      "type": "boolean"
    },
    "owner_handoff": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "declared_sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "scanned_sources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "missing_sources": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "path",
              "reason"
            ]
          }
        }
      },
      "required": [
        "state",
        "declared_sources",
        "scanned_sources",
        "missing_sources"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "measured"
        },
        "estimated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimum_required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fits": {
          "type": "boolean"
        },
        "token_estimate": {
          "const": null
        }
      },
      "required": [
        "strategy",
        "estimated",
        "minimum_required",
        "limit",
        "fits",
        "token_estimate"
      ]
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protected_minimum": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "fidelity": {
                "enum": [
                  "full",
                  "projection",
                  "selected_sections"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "fidelity"
            ]
          }
        },
        "included": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/pinned_resource"
          }
        },
        "excluded": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/pinned_resource"
          }
        }
      },
      "required": [
        "protected_minimum",
        "included",
        "excluded"
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "presentation": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section": {
            "enum": [
              "protected_minimum",
              "relevant",
              "conflicts",
              "unresolved"
            ]
          },
          "refs": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "section",
          "refs"
        ]
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_context_source_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "instruction_composition_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "capsule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "const": null
            }
          },
          "required": [
            "digest"
          ]
        }
      },
      "required": [
        "digest",
        "source_revision",
        "policy_revision",
        "scope_fingerprint",
        "plan_context_source_revision",
        "instruction_composition_digest",
        "capsule"
      ]
    },
    "candidate_digests": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/pinned_resource"
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "exclusion_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "presentation_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "module",
        "sha256"
      ]
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "module",
        "sha256"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "aifhub.context_selection_overlay_observation.v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "sha256"
      ]
    },
    "worktree_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "path",
          "detail"
        ]
      }
    }
  },
  "required": [
    "schema",
    "change_id",
    "generated_at",
    "diagnostic_only",
    "authorizes",
    "language",
    "language_options",
    "run_status",
    "complete",
    "freshness",
    "abstained",
    "needs_review",
    "owner_handoff",
    "coverage",
    "budget",
    "manifest",
    "candidates",
    "presentation",
    "baseline",
    "candidate_digests",
    "rubric",
    "exclusion_policy",
    "presentation_policy",
    "engine",
    "helper",
    "contract",
    "worktree_identity",
    "binding",
    "diagnostics"
  ],
  "$defs": {
    "pinned_resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^cand-[0-9]{1,4}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "file",
            "missing",
            "malformed",
            "truncated"
          ]
        },
        "status": {
          "enum": [
            "included",
            "conflicting",
            "excluded",
            "unassessed"
          ]
        },
        "scores": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "relevance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "evidence_support": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "contradiction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "relevance",
            "evidence_support",
            "contradiction"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "limitation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "conflict": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "suspected",
                "owner_confirmed"
              ]
            },
            "refs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/evidence_ref"
              }
            }
          },
          "required": [
            "state",
            "refs"
          ]
        }
      },
      "required": [
        "candidate_id",
        "path",
        "sha256",
        "bytes",
        "kind",
        "status",
        "scores",
        "reason",
        "limitation",
        "evidence_refs",
        "conflict"
      ],
      "dependentRequired": {
        "conflict": [
          "evidence_refs",
          "status"
        ]
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "start",
            "end"
          ]
        },
        "document_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "span_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "document_sha256"
      ]
    }
  }
}
