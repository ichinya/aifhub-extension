{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision correction fixture v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aifhub.decision_correction_fixture.v1"
    },
    "signature_format_version": {
      "type": "integer",
      "minimum": 1
    },
    "diagnostic_only": {
      "const": true
    },
    "authorizes": {
      "type": "array",
      "maxItems": 0
    },
    "status": {
      "enum": [
        "draft",
        "confirmed",
        "rejected",
        "superseded"
      ]
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "required": [
    "schema",
    "diagnostic_only",
    "authorizes",
    "status",
    "status_reason",
    "payload_digest",
    "payload"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "fixtureFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "enum": [
            "input",
            "support"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": "string",
          "maxLength": 131072
        }
      },
      "required": [
        "path",
        "media_type",
        "sha256",
        "bytes"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "partition": {
          "enum": [
            "development",
            "calibration",
            "held_out"
          ]
        },
        "ambiguity": {
          "enum": [
            "clear",
            "ambiguous"
          ]
        },
        "logical_identity": {
          "$ref": "#/$defs/digest"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "$ref": "#/$defs/identifier"
            },
            "partition": {
              "enum": [
                "development",
                "calibration",
                "held_out"
              ]
            },
            "source_observation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "enum": [
                    "aifhub.requirement_lint_observation.v1",
                    "aifhub.claim_evidence_observation.v1",
                    "aifhub.trace_link_suggestions_observation.v1"
                  ]
                },
                "change_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "language": {
                  "enum": [
                    "ru",
                    "en",
                    "unknown"
                  ]
                },
                "structural": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "checked_scope": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "carrier": {
                          "$ref": "#/$defs/identity_source_input"
                        },
                        "pairs": {
                          "type": "array",
                          "maxItems": 50,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "claim_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200,
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
                              },
                              "parent_claim_id": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "maxLength": 200,
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
                              },
                              "claim_ref": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "maxLength": 500
                              },
                              "source_path": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              "source_span": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "start": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "end": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "start",
                                  "end"
                                ]
                              },
                              "relation": {
                                "enum": [
                                  "literal_quote",
                                  "paraphrase",
                                  "inference"
                                ]
                              },
                              "quote_sha256": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "pattern": "^[a-f0-9]{64}$"
                              },
                              "quote_check": {
                                "enum": [
                                  "exact_found",
                                  "literal_match_out_of_context",
                                  "not_found",
                                  "source_unavailable",
                                  "truncated",
                                  "not_applicable"
                                ]
                              },
                              "quote_span": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "start": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "end": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "document_sha256": {
                                    "type": "string",
                                    "pattern": "^sha256:[a-f0-9]{64}$"
                                  },
                                  "span_sha256": {
                                    "type": "string",
                                    "pattern": "^sha256:[a-f0-9]{64}$"
                                  }
                                },
                                "required": [
                                  "start",
                                  "end",
                                  "document_sha256",
                                  "span_sha256"
                                ]
                              },
                              "known_revision": {
                                "enum": [
                                  "match",
                                  "changed",
                                  "not_declared",
                                  "unverifiable"
                                ]
                              },
                              "known_source_revision": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "pattern": "^sha256:[a-f0-9]{64}$"
                              }
                            },
                            "required": [
                              "claim_id",
                              "parent_claim_id",
                              "claim_ref",
                              "source_path",
                              "source_span",
                              "relation",
                              "quote_sha256",
                              "quote_check",
                              "quote_span",
                              "known_revision",
                              "known_source_revision"
                            ]
                          }
                        },
                        "outcome_summary": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "total": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "by_quote_check": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "exact_found": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "literal_match_out_of_context": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "not_found": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "source_unavailable": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "truncated": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "not_applicable": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                }
                              },
                              "required": [
                                "exact_found",
                                "literal_match_out_of_context",
                                "not_found",
                                "source_unavailable",
                                "truncated",
                                "not_applicable"
                              ]
                            },
                            "by_known_revision": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "match": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "changed": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "not_declared": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                },
                                "unverifiable": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 50
                                }
                              },
                              "required": [
                                "match",
                                "changed",
                                "not_declared",
                                "unverifiable"
                              ]
                            }
                          },
                          "required": [
                            "total",
                            "by_quote_check",
                            "by_known_revision"
                          ]
                        },
                        "missing_sources": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "path": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              }
                            },
                            "required": [
                              "path",
                              "reason"
                            ]
                          }
                        }
                      },
                      "required": [
                        "checked_scope",
                        "carrier",
                        "pairs",
                        "outcome_summary",
                        "missing_sources"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "trace": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
                            "bytes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "schema_version": {
                              "const": "lekalo/trace-manifest/v0.2.16"
                            },
                            "identity": {
                              "const": "dev.lekalo.trace-manifest@0.2.16"
                            },
                            "completeness": {
                              "enum": [
                                "full",
                                "partial"
                              ]
                            },
                            "manifest_digest": {
                              "type": "string",
                              "pattern": "^sha256:[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "path",
                            "sha256",
                            "bytes",
                            "schema_version",
                            "identity",
                            "completeness",
                            "manifest_digest"
                          ]
                        },
                        "scan": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "coverage": {
                              "enum": [
                                "full",
                                "partial",
                                "none"
                              ]
                            },
                            "declared_sources": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100000
                            },
                            "scanned_sources": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100000
                            },
                            "missing_sources": {
                              "type": "array",
                              "maxItems": 100,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "path": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 500
                                  },
                                  "reason": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200
                                  }
                                },
                                "required": [
                                  "path",
                                  "reason"
                                ]
                              }
                            },
                            "delta_spec_inventory": {
                              "type": "array",
                              "maxItems": 100,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              }
                            },
                            "missing_sources_count": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100000
                            },
                            "truncations": {
                              "type": "array",
                              "maxItems": 10,
                              "items": {
                                "enum": [
                                  "graph-truncated",
                                  "anchor-scan-truncated",
                                  "delta-spec-inventory-truncated",
                                  "missing-sources-truncated",
                                  "declared-sources-truncated"
                                ]
                              }
                            }
                          },
                          "required": [
                            "coverage",
                            "declared_sources",
                            "scanned_sources",
                            "missing_sources",
                            "delta_spec_inventory",
                            "missing_sources_count",
                            "truncations"
                          ]
                        },
                        "outcome": {
                          "enum": [
                            "candidate",
                            "related_only",
                            "none",
                            "abstain"
                          ]
                        },
                        "outcome_summary": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "total_nodes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 500
                            },
                            "total_edges": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1000
                            },
                            "by_outcome": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "candidate": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 1000
                                },
                                "related_only": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 1000
                                }
                              },
                              "required": [
                                "candidate",
                                "related_only"
                              ]
                            }
                          },
                          "required": [
                            "total_nodes",
                            "total_edges",
                            "by_outcome"
                          ]
                        },
                        "nodes": {
                          "type": "array",
                          "maxItems": 500,
                          "items": {
                            "$ref": "#/$defs/identity_graph_node"
                          }
                        },
                        "edges": {
                          "type": "array",
                          "maxItems": 1000,
                          "items": {
                            "$ref": "#/$defs/identity_graph_edge"
                          }
                        }
                      },
                      "required": [
                        "trace",
                        "scan",
                        "outcome",
                        "outcome_summary",
                        "nodes",
                        "edges"
                      ]
                    }
                  ]
                },
                "semantic": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "run_status": {
                      "enum": [
                        "complete",
                        "failed",
                        "not_run"
                      ]
                    },
                    "freshness": {
                      "enum": [
                        "current",
                        "stale"
                      ]
                    },
                    "abstained": {
                      "type": "boolean"
                    },
                    "outcome_reason": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 200
                    },
                    "coverage": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "state": {
                          "enum": [
                            "full",
                            "partial",
                            "none"
                          ]
                        },
                        "declared_sources": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "scanned_sources": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100000
                        },
                        "missing_sources": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "path": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              }
                            },
                            "required": [
                              "path",
                              "reason"
                            ]
                          }
                        }
                      },
                      "required": [
                        "state",
                        "declared_sources",
                        "scanned_sources",
                        "missing_sources"
                      ]
                    },
                    "assessments": {
                      "type": "array",
                      "maxItems": 1000,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "claim_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200,
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
                              },
                              "verdict": {
                                "enum": [
                                  "supports",
                                  "contradicts",
                                  "insufficient"
                                ]
                              },
                              "rationale": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              }
                            },
                            "required": [
                              "claim_id",
                              "verdict",
                              "rationale"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "edge_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64,
                                "pattern": "^edge-[0-9]{1,8}$"
                              },
                              "verdict": {
                                "enum": [
                                  "supports",
                                  "contradicts",
                                  "insufficient"
                                ]
                              },
                              "rationale": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              }
                            },
                            "required": [
                              "edge_id",
                              "verdict",
                              "rationale"
                            ]
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "run_status",
                    "freshness",
                    "abstained",
                    "outcome_reason",
                    "coverage",
                    "assessments"
                  ]
                },
                "inputs": {
                  "type": "array",
                  "maxItems": 150,
                  "items": {
                    "$ref": "#/$defs/identity_source_input"
                  }
                },
                "rubric": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ]
                }
              }
            },
            "subject_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "input_revisions": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/digest"
              }
            },
            "question": {
              "$ref": "#/$defs/question"
            },
            "rubric": {
              "$ref": "#/$defs/question"
            }
          },
          "required": [
            "scope",
            "partition",
            "source_observation",
            "subject_revision",
            "input_revisions",
            "question",
            "rubric"
          ]
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "kind": {
              "enum": [
                "redacted",
                "synthetic"
              ]
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/fixtureFile"
              }
            }
          },
          "required": [
            "version",
            "kind",
            "files"
          ]
        },
        "original_assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consumer": {
              "enum": [
                "requirements_semantic_lint",
                "claim_evidence_check",
                "trace_link_suggestions",
                "context_selection_overlay"
              ]
            },
            "verdict": {
              "$ref": "#/$defs/boundedText"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            }
          },
          "required": [
            "consumer",
            "verdict",
            "summary"
          ]
        },
        "expected_label": {
          "$ref": "#/$defs/boundedText"
        },
        "expected_label_confirmed": {
          "type": "boolean"
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "feedback": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "args": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "required": [
            "args"
          ]
        },
        "evolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "transaction_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
                },
                "proposal_digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "required": [
                "transaction_id",
                "proposal_digest"
              ]
            }
          ]
        }
      },
      "required": [
        "case_id",
        "scope",
        "partition",
        "ambiguity",
        "logical_identity",
        "identity",
        "fixture",
        "original_assessment",
        "expected_label",
        "expected_label_confirmed",
        "rationale",
        "feedback",
        "replay",
        "evolution"
      ]
    },
    "identity_source_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
