{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runner metrics v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aifhub.runner_metrics.v1"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "tokens": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "changed_loc": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "unrelated_changes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "human_review_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "verified_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "model": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "harness": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    }
  },
  "required": [
    "schema"
  ]
}
