        "expected_findings": [["owner_decision_assumed", 5]]
      }
    },
    "known_limitations": {
      "notes": "Pins the CURRENT behavior of the documented heuristic limitations (design.md Review Round): false negatives and one false positive caused by line-based scanning and negation/role-blind suppression markers. These labels make the limitation observable; correcting the markers is expected to change these labels in the same commit.",
      "limit-ru-negated-attribution.md": {
        "expected_by_type": { "undefined_observable_outcome": 0, "missing_error_case": 0, "owner_decision_assumed": 0, "suspected_requirement_revision_conflict": 0 },
        "limitation": "false-negative: the negated attribution (решение не согласовано) suppresses the owner finding"
      },
      "limit-en-error-log.md": {
        "expected_by_type": { "undefined_observable_outcome": 0, "missing_error_case": 0, "owner_decision_assumed": 0, "suspected_requirement_revision_conflict": 0 },
        "limitation": "false-negative: the error-token match is the object name (error log), suppressing missing_error_case; log also counts as observable"
      },
      "limit-en-must-not.md": {
        "expected_by_type": { "undefined_observable_outcome": 0, "missing_error_case": 1, "owner_decision_assumed": 0, "suspected_requirement_revision_conflict": 0 },
        "expected_findings": [["missing_error_case", 3]],
        "limitation": "false-positive: a MUST NOT prohibition is scored as a success-path obligation missing error handling"
      }
    }
  }
